# ============================================================
# PERSONAL FINANCE TRACKER — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database (Supabase PostgreSQL — Free Forever) ---
# Get this from: Supabase > Project Settings > Database > Connection String > URI
# Replace [YOUR-PASSWORD] with your Supabase database password
DATABASE_URI="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- Flask Security ---
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-super-secret-key-here"

# --- Google Gemini AI (Receipt Scanner & Insights) ---
# Get from: https://aistudio.google.com/apikey (Free tier available)
GOOGLE_API_KEY="your-google-api-key-here"

# --- Cloudinary (Receipt Image Storage — Free 25GB) ---
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- HuggingFace (Business Insights AI) ---
# Get from: https://huggingface.co/settings/tokens (Free)
HF_API_TOKEN="your-hf-token-here"

# --- Financial Data APIs ---
# Alpha Vantage: https://www.alphavantage.co/support/#api-key (Free)
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-key"

# --- Flask Environment ---
FLASK_ENV=production
